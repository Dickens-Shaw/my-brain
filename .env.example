# 本机配置示例。复制成 .env 后填自己的值，.env 已被 .gitignore 忽略。
#
#   cp .env.example .env
#
# 三个子目录的 run.sh 启动时会自动读取仓库根目录的 .env，
# 也会读取子目录自己的 .env（后者优先，用于覆盖单个管线的配置）。
# 值里有空格时记得加引号。

# ---------- 掘金 ----------
# 掘金用户 ID。打开自己的主页 https://juejin.cn/user/<这串数字>，复制地址栏里的数字。
# 不填的话 juejin-articles-export/run.sh 会直接报错退出。
JUEJIN_USER_ID=

# 掘金 Cookie，只有导出「私有收藏集」才需要（默认那个「我的收藏」通常就是私有的）。
# 留空也能跑，公开收藏集和点赞列表都不需要登录态，只是私有收藏集会缺失。
# 要填就从浏览器 DevTools 里复制这三个字段，别把整串 Cookie 都贴进来：
#   JUEJIN_COOKIE="sessionid=...; sid_tt=...; uid_tt=..."
# 这等价于账号密码，只留在本地的 .env 里，别提交。
JUEJIN_COOKIE=

# ---------- 微信 ----------
# 微信账号目录名，形如 SomeName_1a2b，取自
#   ~/Library/Containers/com.tencent.xinWeChat/Data/Documents/xwechat_files/
# 只登录过一个账号就留空，脚本会自动找到唯一的 favorite.db；
# 有多个账号目录时必须指定，否则脚本会列出候选让你选。
WECHAT_ACCOUNT=

# ---------- 浏览器书签 ----------
# 支持 chrome / chrome-canary / edge / brave / chromium / vivaldi / arc
BROWSER=chrome

# ---------- 通用 ----------
# 输出目录，相对各子目录。改这个要连带确认 .gitignore 是否还盖得住。
# OUTPUT_DIR=output

# 抓正文的并发线程数和请求间隔（秒）。调太猛容易被限流。
# WORKERS=4

# 抓正文时把配图下载到本地：1 开启
# IMAGES=0

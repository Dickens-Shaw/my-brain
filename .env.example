# 本机配置示例。复制成 .env 后填自己的值，.env 已被 .gitignore 忽略。
#
#   cp .env.example .env
#
# exporters/*/run.sh 启动时会自动读取仓库根目录的 .env，
# 也会读取子目录自己的 .env（后者优先，用于覆盖单个管线的配置）。
# TypeScript 层（packages/*、apps/*）同样读取根目录 .env。
# 值里有空格时记得加引号。

# ---------- Knowledge OS / Vault ----------
# 独立私有 Vault 仓库（或本地目录）的绝对路径，形如 /Users/you/my-brain-vault。
# Markdown 知识库的唯一事实来源。别放在本仓库里：正文是他人的版权材料，
# 本公开仓库不存放 Vault 内容。目录可以不存在，pnpm vault:init 会建骨架。
# 不填的话 TypeScript 层的命令启动即报错。
VAULT_PATH=

# ---- embedding 供应商 ----
# 只要求供应商提供 OpenAI 兼容的 /embeddings 接口。
# 正文会发送给云端接口；原始导出数据文件（数据库、Cookie、小册 input）不会上传。
# 全量迁移 + 建索引约 $0.6，其中 95% 花在 chunk 级 embedding 上。
OPENAI_API_KEY=

# 换非 OpenAI 供应商时必须一并改 BASE_URL 与模型、维度，三者要配套。
# 维度填错会污染 vec0 表，首批向量返回时程序会报错并告诉你正确值。
# 改模型或维度后必须全量重建索引：不同模型的向量不在同一空间，混用不会报错，
# 只会让检索结果莫名其妙地变差。
#
#   OpenAI：       https://api.openai.com/v1   text-embedding-3-small  512
#   硅基流动：      https://api.siliconflow.cn/v1  BAAI/bge-m3          1024
#   阿里百炼：      https://dashscope.aliyuncs.com/compatible-mode/v1  text-embedding-v3  1024
#
# OPENAI_BASE_URL=
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSIONS=512

# ---- chat 供应商（主题命名与边界分类）----
# 不填则整套回落到上面的 embedding 供应商。
# 单独配置的典型场景：DeepSeek 只有 chat 接口、没有 /embeddings，
# 于是 embedding 走别家、chat 走 DeepSeek。chat 这部分总共只要几分钱。
# CHAT_API_KEY=
# CHAT_BASE_URL=https://api.deepseek.com
# CHAT_MODEL=gpt-4o-mini

# 可选：索引 SQLite 路径（默认仓库根 .data/index.db，已 gitignore）
# INDEX_PATH=

# ---------- 掘金 ----------
# 掘金用户 ID。打开自己的主页 https://juejin.cn/user/<这串数字>，复制地址栏里的数字。
# 不填的话 exporters/juejin-articles/run.sh 会直接报错退出。
JUEJIN_USER_ID=

# 掘金 Cookie，只有导出「私有收藏集」才需要（默认那个「我的收藏」通常就是私有的）。
# 留空也能跑，公开收藏集和点赞列表都不需要登录态，只是私有收藏集会缺失。
# 要填就从浏览器 DevTools 里复制这三个字段，别把整串 Cookie 都贴进来：
#   JUEJIN_COOKIE="sessionid=...; sid_tt=...; uid_tt=..."
# 这等价于账号密码，只留在本地的 .env 里，别提交。
JUEJIN_COOKIE=

# ---------- 微信 ----------
# 微信账号目录名，形如 SomeName_1a2b，取自
#   ~/Library/Containers/com.tencent.xinWeChat/Data/Documents/xwechat_files/
# 只登录过一个账号就留空，脚本会自动找到唯一的 favorite.db；
# 有多个账号目录时必须指定，否则脚本会列出候选让你选。
WECHAT_ACCOUNT=

# ---------- 浏览器书签 ----------
# 支持 chrome / chrome-canary / edge / brave / chromium / vivaldi / arc
BROWSER=chrome

# ---------- 通用（导出线） ----------
# 输出目录，相对各导出线子目录。改这个要连带确认 .gitignore 是否还盖得住。
# OUTPUT_DIR=output

# 抓正文的并发线程数和请求间隔（秒）。调太猛容易被限流。
# WORKERS=4

# 抓正文时把配图下载到本地：1 开启
# IMAGES=0
